{
  "name": "DuitFlow",
  "short_name": "DuitFlow",
  "description": "Track your transactions, banks, credit, goals and more.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0e17",
  "theme_color": "#0a0e17",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Transactions", "url": "/transactions", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Goals", "url": "/goals", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Calendar", "url": "/calendar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
